# انسخ هذا الملف إلى .env (لا ترفع .env إلى GitHub)
PORT=3000

# المواقع المسموح لها بالاتصال بالخادم (مفصولة بفاصلة). استخدم * أثناء التجربة فقط.
# مثال: https://USERNAME.github.io
CORS_ORIGINS=*

# اختياري: خادم TURN لتحسين المكالمات الصوتية عبر الشبكات المختلفة
# (احصل عليها من خدمة TURN مثل Metered أو Cloudflare أو خادم coturn خاص بك)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
